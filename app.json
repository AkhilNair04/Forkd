{
  "expo": {
    "name": "Forkd",
    "slug": "forkd-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "forkd",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {
      "eas": {
        "projectId": "your-project-id-here"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.forkd.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FORK’D needs your location to show nearby chefs and dishes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.forkd.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "viewport": {
        "width": "device-width",
        "initialScale": 1.0,
        "maximumScale": 1.0,
        "userScalable": false,
        "shrinkToFit": false,
        "viewportFit": "cover"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-image-picker",
      {
        "photosPermission": "Allow access to your photos to upload dish images"
      }
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
